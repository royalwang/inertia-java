{
  "name": "inertia-java-react-example",
  "version": "0.1.0-snapshot.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "benchmark": "node scripts/benchmark.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "ssr": "node dist/ssr/ssr.js",
    "test:ssr-failures": "node scripts/verify-ssr-failures.mjs",
    "ssr:watch": "node --watch dist/ssr/ssr.js",
    "test:ssr-health": "node scripts/verify-ssr-health.mjs",
    "test:build-integrity": "node scripts/verify-build.mjs",
    "test:csp": "node scripts/verify-csp.mjs",
    "publish:assets": "node scripts/release-assets.mjs",
    "test:release-switch": "node scripts/verify-release-switch.mjs",
    "test:assets": "node --test scripts/release-assets.test.mjs",
    "test:custom-root": "node scripts/verify-custom-root.mjs",
    "test:history": "node scripts/verify-history.mjs",
    "test:browser-matrix": "node scripts/verify-browser-matrix.mjs"
  },
  "dependencies": {
    "@inertiajs/react": "3.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@inertiajs/vite": "3.8.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "license": "Apache-2.0"
}
